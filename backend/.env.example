# Copy to backend/.env and fill in what you need. backend/.env is ignored by git.
# Every setting can also be given as an ordinary environment variable.

# --- AI tutor -----------------------------------------------------------------
# Your Anthropic API key. It is used only by the backend and never sent to the browser.
# Leave it empty to use the course without AI features.
ANTHROPIC_API_KEY=

# "anthropic" (default) or "none" to switch every AI feature off.
MATH_AI_PROVIDER=anthropic
MATH_AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max - higher is more thorough, slower and more expensive.
MATH_AI_EFFORT=medium
# Let the API retry a declined request on its recommended fallback model.
MATH_AI_SERVER_FALLBACKS=true

# --- Storage ------------------------------------------------------------------
# Defaults to backend/data/universe.db. Any SQLAlchemy URL works, e.g. postgresql+psycopg://...
# MATH_DATABASE_URL=sqlite:///data/universe.db

# --- Other --------------------------------------------------------------------
# MATH_CONTENT_DIR=../content
# MATH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
